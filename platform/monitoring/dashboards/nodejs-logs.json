  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["nodejs", "loki", "monitoring"],
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "type": 1, "label": "app", "stream": "", "refId": "LokiVariableQueryEditor-VariableQuery" },
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1,
        "label": "Application"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Node.js Application Logs",
  "uid": "nodejs-logs-dashboard",
  "version": 2
}
